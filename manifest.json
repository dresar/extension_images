{
  "manifest_version": 3,
  "name": "InstaForge - Universal Image & CDN Bulk Downloader",
  "version": "1.0.0",
  "description": "Ekstrak & download semua gambar / foto CDN dari halaman web aktif atau daftar URL massal langsung menjadi file .ZIP",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaForge Image Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
